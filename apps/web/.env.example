# Copy to .env.local. Next.js loads that automatically and it is gitignored.

# --- WordPress -------------------------------------------------------------
# Base URL of the CMS. Each tenant is a subdirectory of it, and the network
# root (shared pages) answers at /graphql. Defaults to the apps/cms default.
WORDPRESS_URL=http://localhost:8080

# --- Revalidation ----------------------------------------------------------
# Shared secret for /api/revalidate, which rejects every request while unset.
# Must match CMS_REVALIDATE_SECRET in apps/cms/.env.
REVALIDATE_SECRET=local-development-secret
