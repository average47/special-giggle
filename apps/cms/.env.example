# Copy to .env and adjust. Compose reads .env from this directory automatically.
# These are local development defaults only -- do not reuse them anywhere real.

# --- Host port -------------------------------------------------------------
# Subdirectory Multisite derives tenant URLs from the domain stored in wp_blogs,
# so changing this after the first `up` needs a search-replace. See the README.
WORDPRESS_PORT=8080
WORDPRESS_SITE_URL=http://localhost:8080

# --- Site + admin ----------------------------------------------------------
WORDPRESS_SITE_TITLE=Super Rotary Phone CMS
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=admin
WORDPRESS_ADMIN_EMAIL=admin@example.com

# --- Tenants ---------------------------------------------------------------
# Extra sites beyond the primary, as comma-separated `slug:Title` pairs.
# The primary site is the network root; these are added under it.
WORDPRESS_TENANTS=tenant-a:Tenant A,tenant-b:Tenant B

# --- Core version ----------------------------------------------------------
# Keep in sync with the `wordpress` image tag in docker-compose.yml.
WORDPRESS_CORE_VERSION=7.1.3

# --- Database --------------------------------------------------------------
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_ROOT_PASSWORD=root

# --- Revalidation ----------------------------------------------------------
# Where the frontend listens for "this changed" pings, and a secret that must
# match REVALIDATE_SECRET in apps/web/.env.local. Leave both unset to disable.
# From inside the container the host's Next dev server is host.docker.internal.
CMS_REVALIDATE_URL=http://host.docker.internal:3000/api/revalidate
CMS_REVALIDATE_SECRET=local-development-secret

# --- GraphQL CORS ----------------------------------------------------------
# Comma-separated origins allowed to query /graphql from a browser.
# Unset falls back to http://localhost:3000 (the Next dev server).
CMS_GRAPHQL_ALLOWED_ORIGINS=http://localhost:3000
