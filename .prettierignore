# pnpm owns the formatting of both of these — it rewrites the workspace file
# in place (e.g. normalising `allowBuilds`), so letting Prettier restyle it
# only creates churn.
pnpm-lock.yaml
pnpm-workspace.yaml

# Build output and caches.
.next/
out/
build/
.turbo/

# Generated by `next dev`; it rewrites the file itself.
apps/web/AGENTS.md
apps/web/next-env.d.ts

# Block markup is WordPress's own serialization format, and the block editor
# emits it unindented. Prettier only indents the delimiters -- harmless to the
# parser, but it means hand-edits and editor output never match.
apps/cms/theme/templates/
apps/cms/theme/parts/
